<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native DPI: the window works in physical pixels on every monitor (docs/DISPLAY_MODES_PLAN.md). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DarkColony.Engine\DarkColony.Engine.csproj" />
    <ProjectReference Include="..\DarkColony.Presentation\DarkColony.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Rendering\Sprite.hlsl" CopyToOutputDirectory="PreserveNewest" TargetPath="Shaders\Sprite.hlsl" />
  </ItemGroup>
</Project>
